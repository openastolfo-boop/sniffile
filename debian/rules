#!/usr/bin/make -f
export CGO_ENABLED = 1
export GOFLAGS = -trimpath

VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')

%:
	dh $@

override_dh_auto_build:
	go build -buildvcs=false -ldflags "-s -w -X main.version=$(VERSION)" -o bin/sniffile ./cmd/sniffile

override_dh_auto_test:
	CGO_ENABLED=1 go test ./internal/...

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/sniffile

override_dh_strip:
	dh_strip --no-automatic-dbgsym
